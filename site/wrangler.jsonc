{
  "name": "rent-resilience-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
  ,
  "kv_namespaces": [
    { "binding": "RENT_OPTIN", "id": "039f4c5eb7d649898f3908c09a3b9977" }
  ],
  "routes": [
    { "pattern": "rentresilience.org", "custom_domain": true },
    { "pattern": "www.rentresilience.org", "custom_domain": true },
    { "pattern": "rentresilience.xyz", "custom_domain": true },
    { "pattern": "www.rentresilience.xyz", "custom_domain": true },
    { "pattern": "rent.kylebrodeur.xyz", "custom_domain": true }
  ]
}

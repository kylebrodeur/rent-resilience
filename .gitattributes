# Normalize line endings across platforms (Kyle pulls this repo on Windows too).
* text=auto eol=lf

# Force LF where tools are picky
*.sh text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets: never touch
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary